{
  "commands": [
    [
      ".venv/Scripts/python.exe",
      "-m",
      "coverage",
      "erase"
    ],
    [
      ".venv/Scripts/python.exe",
      "-m",
      "coverage",
      "run",
      "-m",
      "pytest",
      "app/shop/tests/unit",
      "--rootdir=.",
      "-q",
      "--junitxml=reports/unit-test/junit.xml"
    ],
    [
      ".venv/Scripts/python.exe",
      "-m",
      "coverage",
      "json",
      "-o",
      "reports/unit-test/coverage.json"
    ],
    [
      ".venv/Scripts/python.exe",
      "scripts/unit_coverage_summary.py",
      "reports/unit-test/coverage.json",
      "reports/unit-test/coverage-summary.json"
    ]
  ],
  "coverage": "reports/unit-test/coverage.json",
  "junit": "reports/unit-test/junit.xml",
  "timeout_seconds": 600,
  "notes": "--rootdir=. は JUnit の classname をリポジトリ相対モジュール（app.shop.tests.unit.*）に揃えるために付与する。引数が app/ 配下のため既定では app/pyproject.toml（ADDR-012 で追加した [tool.pytest.ini_options]）が configfile となり rootdir=app/ に解決され、classname が shop.tests.unit.* になる。テスト選択・設定内容・計測対象は変わらない。"
}
