# アプリ設定サンプル (ADR-010 / ADR-004)。
# 実値はコミットせず、実行環境ごとに .env や環境変数で注入する。
# 本番のCredential/Secretは絶対にコミットしない。

# DB接続文字列 (PostgreSQL)
DATABASE_URL=postgresql+psycopg://cinema:cinema@localhost:5432/cinema

# セッションCookie署名シークレット (本番では強度の高いランダム値を注入)
SECRET_KEY=please-generate-a-strong-random-secret

# Cookie属性 (本番はHTTPS前提でtrue)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=28800

BCRYPT_ROUNDS=12
PAGE_SIZE=20
