# trace: ADDR-011
# MiniCommerce 環境変数の雛形（NFR-SC-07、NFR-OM-17）。
# 実値は書かない。利用時は本ファイルを .env へ複写し、各環境の値を設定する。
# .env はリポジトリに含めない。

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
# 本番環境（HTTPS）では true、検証環境（HTTP）では false
SESSION_COOKIE_SECURE=false

# Database（PostgreSQL 16）
DB_HOST=db
DB_PORT=5432
DB_NAME=minicommerce
DB_USER=minicommerce
DB_PASSWORD=

# 決済ゲートウェイ（本リリースは模擬実装のみ）
PAYMENT_GATEWAY=mock

# 公開ポート
APP_PORT=8000
DB_PUBLISHED_PORT=5432

# Gunicorn（AP サーバー）
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=30
GUNICORN_LOG_LEVEL=info
