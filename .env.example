# MiniCommerce の設定値の一覧と記入例（ADDR-014 4.3 の1、NFR-OM-17）。
# このファイルをコピーして .env を作成し、空欄の秘密情報を各環境で設定する。.env はリポジトリに含めない。
# 秘密情報（DJANGO_SECRET_KEY・DB_USER・DB_PASSWORD）の値はここに書かない。

# 環境の指定（必須・既定なし）：development（開発・検証環境 ENV-01）または production（本番）
MINICOMMERCE_ENV=development

# Django の秘密鍵（必須・既定なし・秘密情報）。例：python -c "import secrets; print(secrets.token_urlsafe(50))" で生成
DJANGO_SECRET_KEY=

# デバッグ表示（未設定時 false。設定する場合は小文字の true / false のみ。production では true にできない）
DJANGO_DEBUG=false

# 受け付けるホスト名（カンマ区切り。未設定時は development で localhost,127.0.0.1、production で空）
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# データベース接続（DB_USER・DB_PASSWORD は必須・既定なし・秘密情報）
# compose.yaml の app サービスでは DB_HOST=db、DB_PORT=5432 を設定する
DB_HOST=localhost
DB_PORT=5432
DB_NAME=minicommerce
DB_USER=
DB_PASSWORD=

# 開発用機能（試験用状態の設定手段。未設定時 false。小文字の true / false のみ。production では true にできない）
MINICOMMERCE_DEV_FEATURES=false

# HTTPS を終端する前段が付けるヘッダー名と値（本番で前段がある場合。例：X-Forwarded-Proto=https）
MINICOMMERCE_TRUSTED_PROXY_SSL_HEADER=

# 実行単位内の Gunicorn のプロセス数（未設定時 2）
GUNICORN_WORKERS=2
