# MiniCommerce 環境変数の雛形（実値は書かない）
# 利用方法: 本ファイルを .env としてコピーし、各項目へ値を設定する。
# .env はリポジトリへ含めない（NFR-SC-07）。

# アプリケーションの秘密鍵（本番・検証ともに必須。推測困難なランダム文字列）
DJANGO_SECRET_KEY=

# デバッグ表示（本番は false。未設定・解釈不能時は false として扱う）
DJANGO_DEBUG=false

# 接続を受け付けるホスト名（カンマ区切り）
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Cookie の Secure 属性（true/false。未設定・空・解釈不能時は true（Secure 付与）。
# HTTP を使う検証環境でのみ false を明示する）
DJANGO_SECURE_COOKIES=

# ログ出力レベル（DEBUG/INFO/WARNING/ERROR）
DJANGO_LOG_LEVEL=INFO

# 静的ファイルを本アプリケーションから配信するか（true/false。未設定・空・解釈不能時は true。
# 前段のWebサーバーが静的ファイルを配信する環境では false を明示する）
DJANGO_SERVE_STATIC=true

# データベース接続情報（PostgreSQL 16）
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# 決済ゲートウェイ実装（本リリースは模擬実装のみ）
PAYMENT_GATEWAY=payments.mock.MockPaymentGateway
PAYMENT_TIMEOUT_SECONDS=10
